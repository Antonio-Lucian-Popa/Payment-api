# ==========================================================================
# PAYMENT API - EXEMPLU DE CONFIGURARE
# ==========================================================================
# Copiază acest fișier în `.env` și completează valorile reale.
#   cp .env.example .env
# NU commitui niciodată fișierul `.env` (este deja în .gitignore).
# ==========================================================================

# --------------------------------------------------------------------------
# STRIPE (obligatoriu)
# --------------------------------------------------------------------------
# Cheia secretă din Stripe Dashboard > Developers > API keys
# Format: sk_test_... pentru dezvoltare, sk_live_... pentru producție
STRIPE_SECRET_KEY=

# Secretul webhook-ului din Stripe Dashboard > Developers > Webhooks
# Format: whsec_... (obligatoriu pentru verificarea semnăturii pe /api/payment/webhook)
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# SERVER
# --------------------------------------------------------------------------
# Portul pe care ascultă serverul
PORT=3000

# Mediu de rulare: development | production
NODE_ENV=production

# --------------------------------------------------------------------------
# CORS
# --------------------------------------------------------------------------
# Lista de origini permise, separate prin virgulă (fără spații).
# Aceste origini sunt aplicațiile tale care apelează acest serviciu.
ALLOWED_ORIGINS=https://novabytecode.ro,https://www.novabytecode.ro

# --------------------------------------------------------------------------
# SECURITATE (opțional)
# --------------------------------------------------------------------------
# Dacă este setat, fiecare request către /api/payment/* (mai puțin /health și
# /webhook) trebuie să includă header-ul `x-api-key` cu această valoare.
# Lasă gol pentru a dezactiva autentificarea (nerecomandat în producție).
API_KEY=generate_with_openssl_rand_hex_32

# Rate limiting: fereastră (minute) și număr maxim de request-uri per IP.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------------------------------------
# WEBHOOK FORWARDING (opțional)
# --------------------------------------------------------------------------
# După ce un eveniment Stripe este verificat, poate fi retransmis către
# backend-urile aplicațiilor tale, ca acestea să reacționeze (DB, email, etc.).
#
# Una sau mai multe destinații, separate prin virgulă. Gol = dezactivat.
WEBHOOK_FORWARD_URL=http://dentara-api:3000/api/billing/payment-webhook
# Ex: WEBHOOK_FORWARD_URL=https://app1.ro/webhooks/payments,https://app2.ro/hooks/stripe

# Secret pentru semnătura HMAC-SHA256 (recomandat). Destinatarul verifică
# header-ul `x-payment-signature` recalculând HMAC peste body-ul primit.
WEBHOOK_FORWARD_SECRET=generate_with_openssl_rand_hex_32

# Filtru opțional de tipuri de evenimente (separate prin virgulă). Gol = toate.
WEBHOOK_FORWARD_EVENTS=checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.payment_failed
# Ex: WEBHOOK_FORWARD_EVENTS=checkout.session.completed,invoice.paid

# Timeout per request (ms) și număr de reîncercări la eșec.
WEBHOOK_FORWARD_TIMEOUT_MS=5000
WEBHOOK_FORWARD_RETRIES=2
